      "parameters": {
        "jsCode": "const raw = $input.first().json.content || $input.first().json.output || $input.first().json.text;\nconst cleaned = raw.replace(/```json|```/g, '').trim();\nconst parsed = JSON.parse(cleaned);\nconst webhookData = $('Webhook').first().json.body;\nconst webhookBinary = $('Webhook').first().binary; // ← grab the binary too\nreturn [{\n  json: {\n    ...parsed,\n    requirement_id: webhookData.requirement_id,\n    uploaded_by_user_id: webhookData.uploaded_by_user_id || null,\n    evaluated_by_user_id: webhookData.evaluated_by_user_id || null,\n    job_title: webhookData.job_title,\n    description: webhookData.description,\n    qualifications: webhookData.qualifications\n  },\n  binary: webhookBinary\n}];"
