    {
      "parameters": {
        "jsCode": "// === H!RE Score: whole-resume vs whole-job cosine (Sentence-BERT) ===\nconst CAL_LO = 0.0, CAL_HI = 1.0;  // optional calibration; leave equal to disable\n\nconst resumeText = String($input.first().json.text || '');\nconst body = $('Webhook').first().json.body || {};\nconst jobText = `${body.job_title||''} ${body.description||''} ${body.qualifications||''}`.trim();\n\nfunction cos(a,b){let d=0,na=0,nb=0;for(let i=0;i<a.length;i++){d+=a[i]*b[i];na+=a[i]*a[i];nb+=b[i]*b[i];}return d/(Math.sqrt(na)*Math.sqrt(nb)||1);}\nconst clamp=(x,lo,hi)=>Math.min(Math.max(x,lo),hi);\n\nlet hire_score = 0, score_band = 'Unknown';\ntry {\n  const resp = await this.helpers.httpRequest({\n    method: 'POST',\n    url: 'https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction',\n    headers: { Authorization: `Bearer ${$env.HF_API_KEY}`, 'Content-Type': 'application/json' },\n    body: { inputs: [resumeText.slice(0,4000), jobText.slice(0,4000)], options: { wait_for_model: true } },\n    json: true,\n  });\n  const embs = Array.isArray(resp[0][0])\n    ? resp.map(s => { const d=s[0].length,o=new Array(d).fill(0); s.forEach(t=>t.forEach((x,i)=>o[i]+=x)); return o.map(x=>x/s.length); })\n    : resp;\n  let raw = cos(embs[0], embs[1]);\n  if (CAL_HI > CAL_LO) raw = clamp((raw - CAL_LO)/(CAL_HI - CAL_LO), 0, 1);\n  hire_score = Math.round(clamp(raw*100, 0, 100) * 100) / 100;\n} catch (err) { hire_score = 0; }\n\nif      (hire_score >= 70) score_band = 'Strong fit';\nelse if (hire_score >= 55) score_band = 'Good fit, minor gaps';\nelse if (hire_score >= 40) score_band = 'Moderate fit, notable gaps';\nelse                       score_band = 'Weak fit';\n\nreturn [{ json: { ...$input.first().json, hire_score, score_band }, binary: $input.first().binary }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -992,
