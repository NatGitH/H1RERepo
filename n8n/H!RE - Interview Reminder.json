    {
      "parameters": {
        "operation": "getAll",
        "tableId": "Job_Requirements",
        "filters": {
          "conditions": [
            {
              "keyName": "requirement_id",
              "condition": "eq",
              "keyValue": "={{ $('Get Evaluation').item.json.requirement_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        840,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Get Requirement",
      "onError": "continueRegularOutput",
      "credentials": {
        "supabaseApi": {
          "id": "iuTadMY5adk9SnoG",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const interview  = $('Code in JavaScript').item.json;\nconst applicant  = $('Get Applicant').item.json;\nconst requirement = $('Get Requirement').item.json || {};\n\nconst name  = applicant.full_name || 'Applicant';\nconst email = (applicant.email || '').trim();\nconst has_valid_email = email.includes('@') && !email.includes('placeholder');\n\nlet when = interview.interview_date;\ntry { when = new Date(interview.interview_date).toLocaleString('en-US', { dateStyle: 'full', timeStyle: 'short' }); } catch (e) {}\nconst jobTitle = requirement.job_title || 'the role';\nconst note = interview.message ? `<p>${interview.message}</p>` : '';\n\nreturn [{\n  json: {\n    recipient_email: email,\n    has_valid_email,\n    email_subject: `Reminder: Your H!RE interview for ${jobTitle}`,\n    email_html: `<div style=\"font-family: Arial, sans-serif; max-width:600px; margin:0 auto; color:#0d1b3e;\">\\n  <h2 style=\"color:#f97316;\">Interview Reminder</h2>\\n  <p>Hi ${name},</p>\\n  <p>This is a friendly reminder about your upcoming interview for <strong>${jobTitle}</strong>.</p>\\n  <div style=\"background:#f1f5f9; border-radius:8px; padding:16px; margin:16px 0;\">\\n    <p style=\"margin:0;\"><strong>When:</strong> ${when}</p>\\n  </div>\\n  ${note}\\n  <p>We look forward to speaking with you!</p>\\n  <br/>\\n  <p>Best regards,<br/><strong>The H!RE Recruitment Team</strong></p>\\n</div>`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Email Content"
    },
    {
      "parameters": {
