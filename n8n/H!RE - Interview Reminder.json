{
  "name": "H!RE - Interview Reminder",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "days",
              "daysInterval": 1
            }
          ]
        }
      },
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        -360,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Daily"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "Interviews",
        "returnAll": true,
        "matchType": "allFilters",
        "filters": {
          "conditions": [
            {
              "keyName": "interview_status",
              "condition": "eq",
              "keyValue": "scheduled"
            },
            {
              "keyName": "interview_date",
              "condition": "gte",
              "keyValue": "={{ new Date(Date.now() + 24 * 60 * 60 * 1000).toISOString() }}"
            },
            {
              "keyName": "interview_date",
              "condition": "lt",
              "keyValue": "={{ new Date(Date.now() + 48 * 60 * 60 * 1000).toISOString() }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        -160,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Interviews ~1 day out",
      "credentials": {
        "supabaseApi": {
          "id": "iuTadMY5adk9SnoG",
          "name": "Supabase account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Keep only interviews happening 24-48h from now (one reminder per interview,\n// since this runs once a day the window matches each interview exactly once).\nconst lo = Date.now() + 24 * 60 * 60 * 1000;\nconst hi = Date.now() + 48 * 60 * 60 * 1000;\nreturn $input.all().filter(item => {\n  if (item.json.interview_status !== 'scheduled') return false;\n  if (!item.json.interview_date) return false;\n  const t = new Date(item.json.interview_date).getTime();\n  return t >= lo && t < hi;\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        40,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Code in JavaScript"
    },
    {
      "parameters": {
        "operation": "getAll",
        "tableId": "Evaluations",
        "filters": {
          "conditions": [
            {
              "keyName": "evaluation_id",
              "condition": "eq",
              "keyValue": "={{ $json.evaluation_id }}"
            }
          ]
        }
      },
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [
        240,
        0
      ],
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Get Evaluation",
