    {
      "parameters": {
        "jsCode": "function uuidv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, c => {\n    const r = Math.random() * 16 | 0;\n    return (c === 'x' ? r : (r & 0x3 | 0x8)).toString(16);\n  });\n}\nconst evaluation = $('Code in JavaScript').item.json;\nconst applicant = $input.first().json;\nconst score = (evaluation.hire_score !== null && evaluation.hire_score !== undefined) ? evaluation.hire_score : 'N/A';\nconst summary = evaluation.ai_summary || 'No summary available.';\nconst name = applicant.full_name || 'Applicant';\n\nconst plain = `Hi ${name}, after careful review we have decided not to move forward with your application. Your H!RE Score: ${score}%. Summary: ${summary}`;\n\nreturn [{\n  json: {\n    email_log_id: uuidv4(),\n    evaluation_id: evaluation.evaluation_id,\n    resume_id: evaluation.resume_id,\n    applicant_id: applicant.applicant_id,\n    recipient_email: applicant.email,\n    full_name: name,\n    message_plain: plain,\n    email_subject: 'Application Update from H!RE',\n    email_html: `<div style=\"font-family: Arial, sans-serif; max-width:600px; margin:0 auto; color:#0d1b3e;\">\\n  <h2 style=\"color:#f97316;\">Application Update</h2>\\n  <p>Hi ${name},</p>\\n  <p>Thank you for taking the time to apply. After careful review, we have decided not to move forward with your application at this time.</p>\\n  <div style=\"background:#f1f5f9; border-radius:8px; padding:16px; margin:16px 0;\">\\n    <p style=\"margin:0 0 8px;\"><strong>Your H!RE Score:</strong> ${score}%</p>\\n    <p style=\"margin:0;\"><strong>Evaluation summary:</strong> ${summary}</p>\\n  </div>\\n  <p>We genuinely appreciate your interest and wish you the very best in your job search.</p>\\n  <br/>\\n  <p>Best regards,<br/><strong>The H!RE Recruitment Team</strong></p>\\n</div>`\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
