    {
      "parameters": {
        "jsCode": "const oneHourAgo = new Date(Date.now() - 60 * 60 * 1000);\nreturn $input.all().filter(item => {\n  if (item.json.application_status !== 'rejected') return false;\n  if (!item.json.rejected_at) return false;\n  return new Date(item.json.rejected_at) < oneHourAgo;\n});"
      },
      "type": "n8n-nodes-base.code",
